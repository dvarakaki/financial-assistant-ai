# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca faça commit do ".env" de verdade — ele já está no .gitignore.

# Google Gemini (langchain-google-genai) — usado pelo especialista financeiro/agenda e pelo FAQ
GEMINI_API_KEY=

# Groq (langchain-groq) — usado pelo roteador/orquestrador e como fallback do Gemini
GROQ_API_KEY=

# Postgres (transações, categorias) — string completa, ex.: postgres://usuario:senha@host:porta/banco?sslmode=require
DATABASE_URL=

# MongoDB (sessões e memória de longo prazo)
MONGODB_URI=mongodb://localhost:27017

# Qdrant (busca semântica: memória, FAQ e restrições do perfil)
QDRANT_URL=
QDRANT_API_KEY=

# Não utilizado atualmente pelo código — mantido apenas se for integrar no futuro
DEEPSEEK_API_KEY=

# Google Calendar MCP (Etapa 5.2) — cliente MCP do Assessor
# JSON do professor (client_id + secret do app), guardado na raiz do projeto
GOOGLE_OAUTH_CREDENTIALS=gcp-oauth.keys.json
# URL do servidor MCP oficial do Google Calendar
GOOGLE_CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
# Deixe vazio — autenticar() grava o token em google-calendar.token.json
GOOGLE_CALENDAR_ACCESS_TOKEN=

# LangSmith (Etapa 6) — observabilidade/trace. Opcional: a tela /monitor.html
# funciona sem isto. Chave em smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assessor-aula

# Juiz de fidelidade (etapa 7) - chave da TypeSafe (console.typesafe.ai)
TYPESAFE_API_KEY=
